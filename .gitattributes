# Binary files - protect from LF/CRLF conversion or corruption
*.ldb binary
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.zip binary

# Text files - enforce LF line endings
*.json text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# LevelDB packs: never normalize line endings (CURRENT/MANIFEST break with CRLF)
packs/** binary
